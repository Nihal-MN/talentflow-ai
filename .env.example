# ──────────────────────────────────────────────────────────────────────────────
# TalentFlow AI — environment template
#
# Copy to .env  (`cp .env.example .env`) and adjust as needed.
# Every value has a safe default: without any configuration the app runs in
# deterministic mock-AI mode and everything still works end to end.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI provider ───────────────────────────────────────────────────────────────
# auto   → use OpenAI when OPENAI_API_KEY is set, otherwise the offline mock
# openai → always call the OpenAI API (fails loudly if the key is missing)
# mock   → always use the deterministic offline mock (fully hermetic demos/tests)
AI_PROVIDER=auto
OPENAI_API_KEY=
# Optional model overrides (empty = backend defaults, see backend/app/core/config.py)
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# ── Backend ───────────────────────────────────────────────────────────────────
# Leave empty for the zero-setup SQLite dev fallback.
# `docker compose up` overrides this with a PostgreSQL + pgvector URL.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Docker Compose port mappings ──────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=talentflow
POSTGRES_DB=talentflow
