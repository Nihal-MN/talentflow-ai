# Normalize line endings in the repository; keep binaries binary.
* text=auto eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of language statistics (they are noise there)
package-lock.json linguist-generated=true
uv.lock           linguist-generated=true
